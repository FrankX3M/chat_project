# PostgreSQL (async driver)
DATABASE_URL=postgresql+asyncpg://anon_chat:anon_chat@localhost:5432/anon_chat

# Redis — очередь матчинга, онлайн-счётчик, pub/sub, rate limiting
REDIS_URL=redis://localhost:6379/0

# JWT — анонимная авторизация по device_id.
# Если оставить закомментированным — сгенерируется случайный секрет при каждом
# старте процесса (безопасно, но рестарт инвалидирует все текущие сессии).
# Для стабильных сессий между рестартами — сгенерировать один раз и вписать:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# НЕ использовать буквально "change-me-in-production" — с этим значением
# приложение откажется стартовать (см. app/config.py).
# JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Соль для хэширования IP (privacy-by-default, см. CLAUDE.md п.4).
# Та же логика, что и для JWT_SECRET — сгенерировать отдельным вызовом той же
# команды (не переиспользовать значение JWT_SECRET).
# IP_HASH_SALT=

# Реконнект / очередь
ROOM_RECONNECT_GRACE_SECONDS=20
MATCH_LOOP_INTERVAL_SECONDS=1.0

# Rate limiting на /search/start (см. CLAUDE.md п.7)
SEARCH_START_RATE_LIMIT=10
SEARCH_START_RATE_WINDOW_SECONDS=60

ENVIRONMENT=local
